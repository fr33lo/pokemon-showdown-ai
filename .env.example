# Pokemon Showdown credentials
PS_USERNAME=your_username
PS_PASSWORD=your_password
PS_SERVER=wss://sim3.psim.us/showdown/websocket

# Anthropic API key for Claude
ANTHROPIC_API_KEY=your_api_key

# Battle format
BATTLE_FORMAT=gen9randombattle

# Optional: auto-queue new battles after each game
AUTO_QUEUE=true

# Optional: max battles to play (0 = unlimited)
MAX_BATTLES=0
